#include <stdio.h>
#include <string.h>

#include "common.h"

static const char* TYPE_CAPTION[] = {
    "T_NON      ",
    "T_NUMBER   ",
    "T_WORD     ",
    "T_OBJECT   ",
    "T_CLASS    ", 
    "T_DOT      ",
    "T_KEYWORD  ",
    "T_METHOD   ",
    "T_PARAMETER",
    "T_ASTERISK ",
    "T_POINTER  ",
    "T_TYPE     ",
    "T_VALUE    ",
    "T_SEMICOLON",
    "T_WSPACE   ",
    "T_COMMA    "};

char* RBufElement_toString(char* tostring, const char* str, const buftype type) {
    
    if ( type < sizeof(TYPE_CAPTION)/sizeof(TYPE_CAPTION[0]) ) {
        strcat(tostring, TYPE_CAPTION[type]);
    } else {
        strcat(tostring, "UNKNOWN    ");
    }
    strcat(tostring, ":");
    strcat(tostring, str);
    return tostring;
}

/**
* @class RBuf
* @brief Ring Buffer
*/
#class $RBuf

char buf[MAX_ARRAYSIZE][MAX_TEXT];   /* buf */
buftype type[MAX_ARRAYSIZE];
char thispointer_str[MAX_TEXT];
char thisclass_str[MAX_TEXT];
boolean isVerbose;
boolean overflow;
int first;
int last;


/**
* @brief initialize
* @memberof RBuf
*/
#+void init(const char* thispointer_str, boolean isVerbose){
    @first = 0;
    @last = 0;
    @overflow = FALSE;
    @thispointer_str[0] = 0;
    strncat( @thispointer_str, thispointer_str, MAX_TEXT - 1);
    @isVerbose = isVerbose;
}

/**
* @brief set class string
* @memberof RBuf
*/
#+void setClass(const char* thisclass_str){
    @thisclass_str[0] = 0;
    strncat( @thisclass_str, thisclass_str, MAX_TEXT - 1);
}

/**
* @brief enque
* @memberof RBuf
*/
#+void enque(const char* str, const int len, const buftype type){
    (void)len;  /* kept for the interface : the whole string is copied */
    int next = (@last + 1 == MAX_ARRAYSIZE) ? 0 : @last + 1;
    if (next == @first) {
        /* the buffer is full : keep what is queued and report it */
        @overflow = TRUE;
        return;
    }
    memset(&(@buf[@last][0]), 0, MAX_TEXT);
    strncpy( &(@buf[@last][0]), str, MAX_TEXT - 1);
    @type[@last] = type;
    @last = next;
}

/**
* @brief true (once) if enque had to drop an element because the buffer was full
* @memberof RBuf
*/
#+boolean popOverflow(){
    boolean ret = @overflow;
    @overflow = FALSE;
    return ret;
}

/**
* @brief deque
* @memberof RBuf
*/
#+char* deque(buftype* p_type){
    char* ret = @buf[@first];
    *p_type = @type[@first];
    @first++;
    if (@first==MAX_ARRAYSIZE) {@first=0;}
    return ret;
}

/**
* @brief empty check
* @memberof RBuf
*/
#()+boolean isEmpty(){
    return (@first==@last?TRUE:FALSE);
}

#+char* allDeque(char* buf){
    buftype type;
    char* str;
    buf[0] = 0;
    while(@isEmpty() == FALSE) {
        str = @deque(&type);
        
        char tostring[MAX_TEXT*2] = {0};
        if (@isVerbose) printf("element :%s\n", RBufElement_toString(tostring, str, type) );
        
        switch(type) {
        case T_OBJECT:
            strcat(buf, @thispointer_str);
            strcat(buf, "->");
            break;
        case T_METHOD:
            strcat(buf, @thisclass_str);
            strcat(buf, "_");
            break;
        default:
            break;
        }
        strcat(buf,  str);
    }
    if (@isVerbose) printf("----------\n");
    return buf;
}

#+boolean back_retype(const buftype find, const buftype replace){
    return @back_retype_stop(find, replace, T_DOT);
}

/**
* @brief retype the nearest element of type find before the end,
*        giving up at T_DOT or at the type stop
* @memberof RBuf
*/
#+boolean back_retype_stop(const buftype find, const buftype replace, const buftype stop){
    if (@isEmpty() ) return FALSE;
    
    int index = @last;
    while( index != @first) {
        index--;
        if ( index < 0 ) index=MAX_ARRAYSIZE-1;
        if ( @type[index] == T_DOT || @type[index] == stop ) { return FALSE; }
        if ( @type[index] == find ) {
            @type[index] = replace;
            return TRUE;
        }
    }
    return FALSE;
}

/**
* @brief copy the text before the T_PARAMETER element (the declared type)
*        out holds MAX_TEXT chars : a longer type is cut
* @return out, or 0 if there is no T_PARAMETER element
* @memberof RBuf
*/
#()+char* typeBeforeParameter(char* out){
    int i = @first;
    int len;
    out[0] = 0;
    while (i != @last) {
        if (@type[i] == T_PARAMETER) {
            len = strlen(out);
            while (len > 0 && out[len-1] == ' ') {
                out[--len] = 0;
            }
            return out;
        }
        strncat(out, @buf[i], MAX_TEXT - 1 - strlen(out));
        i++;
        if (i == MAX_ARRAYSIZE) i = 0;
    }
    return 0;
}

#()+const char* back_getStr(const buftype find){
    if (@isEmpty() ) return 0;
    
    int index = @last;
    while( index != @first) {
        index--;
        if ( index < 0 ) index=MAX_ARRAYSIZE-1;
        if ( @type[index] == find ) {
            return @buf[index];
        }
    }
    return 0;
}

#+void trimQue(){
    int i;
    if (@first == @last) return;

    if (@first < @last) {
        for (i = @first; i<@last; i++)
        {
            if( @type[i] == T_WSPACE ) {
                @first++;
            } else {
                break;
            }
        }
    } else {
        boolean isContinue = TRUE;
        for (i = @first; i<MAX_ARRAYSIZE; i++)
        {
            if( @type[i] == T_WSPACE ) {
                @first++;
            } else {
                isContinue = FALSE;
                break;
            }
        }
        if (isContinue) {
            for (i = 0; i<@last; i++)
            {
                if( @type[i] == T_WSPACE ) {
                    @first++;
                } else {
                    break;
                }
            }
        }
    }
    return;
}

#+boolean isWSPACE(){
    int i;
    if (@first == @last) return FALSE;

    if (@first < @last) {
        for (i = @first; i<@last; i++)
        {
            if(@type[i]!=T_WSPACE) return FALSE;
        }
    } else {
        for (i = @first; i<MAX_ARRAYSIZE; i++)
        {
            if(@type[i]!=T_WSPACE) return FALSE;
        }
        for (i = 0; i<@last; i++)
        {
            if(@type[i]!=T_WSPACE) return FALSE;
        }
    }
    return TRUE;
}

/**
* @brief toString
* @param buf A string that represents the current object.
* @return A string that represents the current object.
*/
#()+char* toString(char* tostring){
    int i;
    if (@first == @last) return tostring;

    if (@first < @last) {
        for (i = @first; i<@last; i++)
        {
            char element_tostring[MAX_TEXT*2] = {0};
            strcat(tostring, RBufElement_toString(element_tostring, @buf[i], @type[i]) );
            strcat(tostring, "\n");
        }
    } else {
        for (i = @first; i<MAX_ARRAYSIZE; i++)
        {
            char element_tostring[MAX_TEXT*2] = {0};
            strcat(tostring, RBufElement_toString(element_tostring, @buf[i], @type[i]) );
            strcat(tostring, "\n");
        }
        for (i = 0; i<@last; i++)
        {
            char element_tostring[MAX_TEXT*2] = {0};
            strcat(tostring, RBufElement_toString(element_tostring, @buf[i], @type[i]) );
            strcat(tostring, "\n");
        }
    }
    return tostring;
}

#endclass
