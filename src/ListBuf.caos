#include <stdlib.h>

#import $Element

#header
typedef struct Element Element;
#endheader
#singleton $List<T>

int length;
T** elements;

#+void init()
{
    @length = 0;
}

#+void append(T* element)
{
    @length++;
    @elements = realloc(@elements, sizeof(T*)*@length);
    if (@elements) {
        @elements[@length-1] = element;
    }
}

#+int length()
{
    return @length;
}

#+T* element(int index)
{
    return @elements[index];
}

#+void finish()
{
    while ( @length>0 ) {
        T* e = @elements[@length-1];
        e->finish();
        e->delete();
        @length--;
    }
    free(@elements);
}

#endsingleton

#instance $ListBuf = $List<Element>
