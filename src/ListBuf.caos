#include <stdlib.h>

#include "Element.h"

#header
typedef struct Element Element;
#endheader
#singleton $List<T>

int length;
T** elements;

#+void init()
{
    @length = 0;
}

#+void append(T* element)
{
    @length++;
    @elements = realloc(@elements, sizeof(T*)*@length);
    if (@elements) {
        @elements[@length-1] = element;
    }
}

#+int length()
{
    return @length;
}

#+T* element(int index)
{
    return @elements[index];
}

#+void finish()
{
    while ( @length>0 ) {
        T_finish(@elements[@length-1]);
        T_delete(@elements[@length-1]);
        @length--;
    }
    free(@elements);
}

#endsingleton

#instance $ListBuf = $List<Element>
