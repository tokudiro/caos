#include <ctype.h>

#include "common.h"

#utility $SLib

#$char* chopRet(char* buf){
    unsigned int len;
    for (len=0; len<MAX_ALLQUE; len++) {
        if (0==buf[len]) {
            break;
        }
    }
    if (len==0) return buf;
    if ( '\n' == buf[len-1] ) buf[len-1]=0;
    return buf;
}

#$void toupper( char* output, const char* input ){
    
    for(; *input!=0; input++, output++ ){
        *output = toupper(*input);
    }
}

#$int checkLength(char* buf){
    int length = 0;
    while(*buf!=0){
        length++;
        buf++;
    }
    return length;
}

#endutility
