CFLAGS ?= -Wall -Wextra

.PHONY: all
all : caos

# The classes of caos itself are written in src/*.caos and generated by caos
# itself. The generated files are committed (so that caos can be built without
# caos); make regen rebuilds them with the built caos.
# the classes are every src/*.caos; -Lp unless OPT_<class> says otherwise
CLASSES = $(sort $(basename $(notdir $(wildcard ./src/*.caos))))
OPT_SLib = -Lpd

.PHONY: regen
regen : caos
	$(foreach c,$(CLASSES),./caos $(or $(OPT_$(c)),-Lp) -o ./src ./src/$(c).caos &&) true

.PHONY: test
test : caos
	sh ./test/test.sh

.PHONY: clean
clean :
	$(RM) caos ./obj/caos.l ./obj/caos.yy.c

./obj/caos.l : ./src/*.l ./src/prolog.c ./src/*.h
	@if [ ! -d obj ]; then \
		mkdir obj; \
	fi
	echo %{>  ./obj/caos.l
	cat ./src/prolog.c  >> ./obj/caos.l
	echo %}>> ./obj/caos.l
	cat ./src/keyword.l >> ./obj/caos.l
	echo %%>> ./obj/caos.l
	cat ./src/INITIAL.l \
	    ./src/IMPORT.l \
	    ./src/INTERFACE.l \
	    ./src/TEMPLATE.l \
	    ./src/CLASS_DEFINE.l \
	    ./src/CLASS_SCOPE.l \
	    ./src/METHOD_DEFINE.l \
	    ./src/METHOD_SCOPE.l \
	    ./src/ATTRIBUTE_DEFINE.l \
	    ./src/EOF.l \
	    >> ./obj/caos.l

./obj/caos.yy.c : ./obj/caos.l
	$(LEX) -o./obj/caos.yy.c ./obj/caos.l

SRCS = ./src/Caos.c ./src/RBuf.c ./src/main.c ./src/SBuf.c ./src/SLib.c ./src/Element.c ./src/ListBuf.c ./src/iface.c ./src/template.c ./src/str.c ./src/proto.c ./src/vars.c ./src/contract.c

caos : ./obj/caos.yy.c $(SRCS) ./src/*.h
	$(CC) $(CFLAGS) -I./src -o caos ./obj/caos.yy.c $(SRCS) $(LDFLAGS)
